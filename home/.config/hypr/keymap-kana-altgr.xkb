xkb_keymap {
  xkb_keycodes { include "evdev+aliases(qwerty)" };
  xkb_types { include "complete" };
  xkb_compat { include "complete" };
  xkb_symbols {
    include "pc+us+inet(evdev)+ctrl(nocaps)"
    // Katakana/Hiragana acts as right Alt (Mod1), matching native ALT binds.
    replace key <HKTG> { type[Group1] = "ONE_LEVEL", [ Alt_R ] };
    modifier_map Mod1 { <HKTG> };
  };
};
