#!/usr/bin/env bash
# gpu-mode: manage Intel iGPU + NVIDIA dGPU hybrid graphics (Optimus/PRIME).
#
# Modes:
#   nvidia  - NVIDIA primary (default Omarchy behavior). Hyprland restart needed.
#   prime   - iGPU primary, NVIDIA available via prime-run, sleeps in D3cold. Hyprland restart needed.
#   off     - blacklist NVIDIA modules entirely (max battery). Reboot required.
#   on      - remove blacklist (returns to prime mode). Reboot required.
#   status  - print current mode and power state.
#
# The NVIDIA/Intel PCI+DRM paths are auto-detected. D3cold needs
# `options nvidia NVreg_DynamicPowerManagement=0x02` in /etc/modprobe.d/
# (set up manually; see the hey-omarchy README).

set -euo pipefail

# Quattro loads Lua, not envs.conf: this module is required (when present) by
# hey-omarchy.lua, after Omarchy's own nvidia.lua, so its env wins.
GPU_LUA="${HEY_GPU_LUA:-$HOME/.config/hypr/hey-omarchy-gpu.lua}"
# Pre-Quattro state; retired on the first mode switch.
LEGACY_ENVS_CONF="${HYPR_ENVS_CONF:-$HOME/.config/hypr/envs.conf}"
BLACKLIST="/etc/modprobe.d/disable-nvidia.conf"

MARK_BEGIN="# >>> gpu-mode managed (do not edit between markers) >>>"
MARK_END="# <<< gpu-mode managed <<<"

die() { echo "ERROR: $*" >&2; exit 1; }

# Resolve NVIDIA + Intel GPU PCI addresses and DRM card paths from sysfs.
detect_gpus() {
  NVIDIA_PCI=""
  NVIDIA_DRM=""
  INTEL_DRM=""

  local link addr vendor name
  for link in /dev/dri/by-path/pci-*-card; do
    [[ -e "$link" ]] || continue
    name="${link##*/pci-}"
    addr="${name%-card}"
    [[ -r "/sys/bus/pci/devices/$addr/vendor" ]] || continue
    vendor="$(cat "/sys/bus/pci/devices/$addr/vendor")"
    case "$vendor" in
      0x10de) NVIDIA_PCI="$addr"; NVIDIA_DRM="$link" ;;
      0x8086) INTEL_DRM="$link" ;;
    esac
  done

  [[ -n "$INTEL_DRM" ]] || die "could not detect an Intel iGPU DRM device"
}

render_block() {
  echo "-- Generated by gpu-mode; edits are overwritten. Switch with: gpu-mode <mode>"
  case "$1" in
    nvidia)
      cat <<EOF
-- Mode: nvidia (NVIDIA primary)
hl.env("NVD_BACKEND", "direct")
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
EOF
      ;;
    prime)
      cat <<EOF
-- Mode: prime (iGPU primary, NVIDIA on demand via prime-run)
hl.env("AQ_DRM_DEVICES", "$INTEL_DRM:$NVIDIA_DRM")
hl.env("LIBVA_DRIVER_NAME", "iHD")
EOF
      ;;
    off)
      cat <<EOF
-- Mode: off (NVIDIA blacklisted; iGPU only)
hl.env("AQ_DRM_DEVICES", "$INTEL_DRM")
hl.env("LIBVA_DRIVER_NAME", "iHD")
EOF
      ;;
  esac
}

# The old marker block in envs.conf is inert under Quattro. Drop it so a stale
# mode cannot come back if the user still sources that file somewhere.
retire_legacy_block() {
  local tmp
  [[ -f "$LEGACY_ENVS_CONF" ]] || return 0
  grep -qF "$MARK_BEGIN" "$LEGACY_ENVS_CONF" || return 0

  tmp="$(mktemp)"
  awk -v begin="$MARK_BEGIN" -v end="$MARK_END" '
    BEGIN { skip = 0 }
    {
      if ($0 == begin) { skip = 1; next }
      if (skip && $0 == end) { skip = 0; next }
      if (!skip) print
    }
  ' "$LEGACY_ENVS_CONF" > "$tmp"
  mv "$tmp" "$LEGACY_ENVS_CONF"
  echo "-> removed the obsolete gpu-mode block from $LEGACY_ENVS_CONF"
}

apply_envs() {
  local mode="$1"
  local tmp

  mkdir -p "$(dirname "$GPU_LUA")"
  tmp="$(mktemp)"
  {
    render_block "$mode"
    # Explicit truthy return: hey-omarchy.lua tests the module to decide whether
    # gpu-mode owns the GPU environment.
    echo "return true"
  } > "$tmp"
  chmod 0644 "$tmp"
  mv "$tmp" "$GPU_LUA"
  retire_legacy_block
}

current_mode() {
  if [[ -f "$BLACKLIST" ]]; then
    if lsmod 2>/dev/null | grep -q '^nvidia '; then
      echo "off (pending reboot - modules still loaded)"
    else
      echo "off"
    fi
    return
  fi
  if [[ -f "$GPU_LUA" ]] && grep -qF "Mode: prime" "$GPU_LUA"; then
    echo "prime"
  elif [[ -f "$GPU_LUA" ]] && grep -qF "Mode: off" "$GPU_LUA"; then
    echo "off (envs only - blacklist missing, will boot with nvidia)"
  else
    echo "nvidia"
  fi
}

cmd_status() {
  detect_gpus
  echo "Mode:               $(current_mode)"
  echo "NVIDIA PCI:         ${NVIDIA_PCI:-not present}"
  if [[ -n "$NVIDIA_PCI" ]]; then
    echo "PCI runtime status: $(cat "/sys/bus/pci/devices/$NVIDIA_PCI/power/runtime_status" 2>/dev/null || echo n/a)"
    echo "PCI power state:    $(cat "/sys/bus/pci/devices/$NVIDIA_PCI/power_state" 2>/dev/null || echo n/a)"
    echo "PCI runtime ctrl:   $(cat "/sys/bus/pci/devices/$NVIDIA_PCI/power/control" 2>/dev/null || echo n/a)"
  fi
  if command -v nvidia-smi >/dev/null 2>&1 && [[ ! -f "$BLACKLIST" ]]; then
    echo
    nvidia-smi --query-gpu=name,pstate,power.draw,memory.used --format=csv 2>/dev/null || true
  fi
  if [[ -r /sys/class/power_supply/BAT0/power_now ]]; then
    awk '{printf "Battery draw:       %.2f W\n", $1/1000000}' /sys/class/power_supply/BAT0/power_now
  fi
}

cmd_off() {
  detect_gpus
  [[ -n "$NVIDIA_PCI" ]] || die "no NVIDIA GPU detected; nothing to disable"
  sudo tee "$BLACKLIST" >/dev/null <<'EOF'
# Managed by gpu-mode: completely disable NVIDIA dGPU
blacklist nouveau
blacklist nvidia
blacklist nvidia_drm
blacklist nvidia_modeset
blacklist nvidia_uvm
EOF
  apply_envs off
  echo "-> NVIDIA modules blacklisted. Reboot to apply."
  echo "   Re-enable later with: gpu-mode on"
}

cmd_on() {
  detect_gpus
  if [[ -f "$BLACKLIST" ]]; then
    sudo rm -f "$BLACKLIST"
  fi
  apply_envs prime
  echo "-> Blacklist removed. Reboot to load NVIDIA modules."
  echo "   After reboot you'll be in PRIME mode (iGPU primary, prime-run for NVIDIA)."
}

cmd_prime() {
  [[ -f "$BLACKLIST" ]] && die "NVIDIA is currently blacklisted. Run 'gpu-mode on' && reboot first."
  detect_gpus
  [[ -n "$NVIDIA_DRM" ]] || die "no NVIDIA GPU detected; prime mode needs one"
  apply_envs prime
  echo "-> PRIME mode set in $GPU_LUA."
  echo "   Restart Hyprland for full effect."
  echo "   Use 'prime-run <cmd>' to run apps on NVIDIA."
}

cmd_nvidia() {
  [[ -f "$BLACKLIST" ]] && die "NVIDIA is currently blacklisted. Run 'gpu-mode on' && reboot first."
  detect_gpus
  apply_envs nvidia
  echo "-> NVIDIA-primary mode set. Restart Hyprland."
}

case "${1:-status}" in
  off)    cmd_off ;;
  on)     cmd_on ;;
  prime)  cmd_prime ;;
  nvidia) cmd_nvidia ;;
  status) cmd_status ;;
  -h|--help|help)
    sed -n '2,11p' "$0" | sed 's/^# \?//'
    echo
    echo "Usage: gpu-mode {nvidia|prime|off|on|status}"
    ;;
  *)
    echo "Usage: gpu-mode {nvidia|prime|off|on|status}" >&2
    exit 1
    ;;
esac
