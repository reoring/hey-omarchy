#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/hey-hypr-common"

notify() {
  local message="$1"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Mouse pointer" "$message" -t 1800 || true
  fi
}

refresh_shell() {
  omarchy-shell hey-omarchy refresh cursor-invisible >/dev/null 2>&1 || true
}

usage() {
  printf '%s\n' "Usage: $(basename "$0") [toggle|on|off|status]" >&2
}

read_mode() {
  hyprctl getoption cursor:invisible -j | jq -er '
    if .bool == true then "on"
    elif .bool == false then "off"
    else error("cursor:invisible is unavailable") end'
}

set_mode() {
  local target="$1"
  local value
  case "$target" in
    on) value="true" ;;
    off) value="false" ;;
    *) return 2 ;;
  esac

  hypr_eval "hl.config({ cursor = { invisible = $value } })"
}

action="${1:-toggle}"
case "$action" in
  toggle|on|off|status) ;;
  *)
    usage
    exit 2
    ;;
esac

if ! command -v hyprctl >/dev/null 2>&1; then
  notify "hyprctl not found"
  exit 1
fi

if [[ "$action" == "status" ]]; then
  read_mode
  exit 0
fi

current="unknown"
current="$(read_mode 2>/dev/null || true)"
if [[ "$action" == "toggle" ]]; then
  if [[ "$current" == "on" ]]; then
    action="off"
  else
    action="on"
  fi
fi

rc=0
if set_mode "$action"; then
  if [[ "$action" == "on" ]]; then
    notify "Hidden"
  else
    notify "Visible"
  fi
else
  notify "Failed to switch pointer visibility"
  rc=1
fi

refresh_shell
exit "$rc"
