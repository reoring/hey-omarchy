#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/hey-hypr-common"

# Adjust Hyprland's gaps for the active workspace.
# Workspace rules keep each adjustment local to the active workspace.

STEP_OUT=${STEP_OUT:-2}
STEP_IN=${STEP_IN:-1}
MIN=${MIN:-0}
MAX_OUT=${MAX_OUT:-80}
MAX_IN=${MAX_IN:-80}

usage() {
  echo "Usage: $(basename "$0") up|down" >&2
}

direction="${1:-}"
case "$direction" in
  up|down) ;;
  *) usage; exit 2 ;;
esac

workspace_id=$(hyprctl activeworkspace -j | jq -r '.id')
if [[ -z "$workspace_id" || "$workspace_id" == "null" ]]; then
  exit 0
fi

rules_json=$(hyprctl workspacerules -j)

default_out=$(hyprctl -j getoption general:gaps_out | jq -er '.css | split(" ")[0] | tonumber')
default_in=$(hyprctl -j getoption general:gaps_in | jq -er '.css | split(" ")[0] | tonumber')
default_border=$(hyprctl -j getoption general:border_size | jq -er '.int')

current_rule=$(jq -c --arg ws "$workspace_id" '
  [.[] | select(.workspaceString == $ws and .enabled != false)] | add // {}' <<<"$rules_json")
current_out=$(jq -r --argjson fallback "$default_out" '.gapsOut[0] // $fallback' <<<"$current_rule")
current_in=$(jq -r --argjson fallback "$default_in" '.gapsIn[0] // $fallback' <<<"$current_rule")
current_border=$(jq -r --argjson fallback "$default_border" '.borderSize // $fallback' <<<"$current_rule")

if [[ "$direction" == "up" ]]; then
  next_out=$((current_out + STEP_OUT))
  next_in=$((current_in + STEP_IN))
else
  next_out=$((current_out - STEP_OUT))
  next_in=$((current_in - STEP_IN))
fi

if (( next_out < MIN )); then
  next_out=$MIN
elif (( next_out > MAX_OUT )); then
  next_out=$MAX_OUT
fi

if (( next_in < MIN )); then
  next_in=$MIN
elif (( next_in > MAX_IN )); then
  next_in=$MAX_IN
fi

if (( next_out == 0 )); then
  next_in=0
fi

next_border=$current_border
if (( next_out == 0 && next_in == 0 )); then
  next_border=0
elif (( next_border == 0 )); then
  next_border=$default_border
fi

hypr_eval "hl.workspace_rule({ workspace = $(hypr_lua_string "$workspace_id"), gaps_out = tonumber($(hypr_lua_string "$next_out")), gaps_in = tonumber($(hypr_lua_string "$next_in")), border_size = tonumber($(hypr_lua_string "$next_border")) })"
notify-send "Workspace gaps" "ws=${workspace_id} out=${next_out} in=${next_in} border=${next_border}" -t 1200
