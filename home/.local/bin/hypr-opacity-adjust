#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/hey-hypr-common"

STEP=${STEP:-0.05}
MIN=${MIN:-0.20}
MAX=${MAX:-1.00}
DEFAULT=${DEFAULT:-1.00}
TAG_PREFIX=${TAG_PREFIX:-alpha_}

usage() {
  echo "Usage: $(basename "$0") up|down" >&2
}

direction="${1:-}"
case "$direction" in
  up|down) ;;
  *) usage; exit 2 ;;
esac

active_json=$(hyprctl activewindow -j)
addr=$(jq -r '.address' <<<"$active_json")
if [[ -z "$addr" || "$addr" == "null" ]]; then
  exit 0
fi

current_tag=$(jq -r --arg prefix "$TAG_PREFIX" '[.tags[]? | select(startswith($prefix))][0] // empty' <<<"$active_json")
current_tag=${current_tag%\*}

current=""
if [[ -n "$current_tag" ]]; then
  current=${current_tag#"$TAG_PREFIX"}
fi

if [[ -z "$current" ]]; then
  current=$(hyprctl getprop "address:$addr" opacity 2>/dev/null | head -n1 || true)
fi
if [[ -z "$current" ]]; then
  current=$DEFAULT
fi

next=$( 
  DIR="$direction" STEP="$STEP" MIN="$MIN" MAX="$MAX" CUR="$current" \
  python - <<'PY'
import os
import math

direction = os.environ['DIR']
step = float(os.environ['STEP'])
minv = float(os.environ['MIN'])
maxv = float(os.environ['MAX'])
cur = float(os.environ['CUR'])

eps = 1e-9
q = cur / step
nearest_i = int(round(q))
on_grid = abs(q - nearest_i) < eps

if direction == 'down':
  if on_grid:
    nxt = (nearest_i - 1) * step
  else:
    nxt = math.floor(q) * step
else:
  if on_grid:
    nxt = (nearest_i + 1) * step
  else:
    nxt = math.ceil(q) * step

nxt = max(minv, min(maxv, nxt))
print(f"{nxt:.2f}")
PY
)

next_tag="${TAG_PREFIX}${next}"

# Remove any existing alpha_* tags from the active window.
while IFS= read -r t; do
  [[ -z "$t" ]] && continue
  t=${t%\*}
  if [[ "$t" == ${TAG_PREFIX}* ]]; then
    hypr_dispatch "hl.dsp.window.tag({ tag = $(hypr_lua_string "-$t"), window = $(hypr_lua_string "address:$addr") })"
  fi
done < <(jq -r '.tags[]?' <<<"$active_json")

# Apply tag so windowrules can persist the chosen opacity across reloads.
hypr_dispatch "hl.dsp.window.tag({ tag = $(hypr_lua_string "+$next_tag"), window = $(hypr_lua_string "address:$addr") })"

# Apply immediately even for an environment-customized step between tag rules.
hypr_eval "local window = $(hypr_lua_string "address:$addr")
  local opacity = $(hypr_lua_string "$next")
  local function set(prop, value)
    local result = hl.dispatch(hl.dsp.window.set_prop({ window = window, prop = prop, value = value }))
    assert(result.ok, result.error)
  end
  set('opaque', opacity == '1.00' and 'on' or 'off')
  for _, prop in ipairs({ 'opacity', 'opacity_inactive', 'opacity_fullscreen' }) do
    set(prop, opacity)
    set(prop .. '_override', '1')
  end"
notify-send "Window opacity" "$next" -t 1200
